{
    "name": "videocall-app",
    "version": "1.8.34",
    "description": "A private WebRTC peer-to-peer video calling application",
    "main": "server.js",
    "scripts": {
        "prestart": "node -e \"const fs=require('fs'),path=require('path');const src=path.join(__dirname,'app/src/config.template.js'),dst=path.join(__dirname,'app/src/config.js');if(!fs.existsSync(dst)){fs.copyFileSync(src,dst);console.log('Created config.js from template');}\"",
        "start": "node app/src/server.js",
        "start-dev": "nodemon app/src/server.js",
        "test": "mocha tests/*.js",
        "lint": "npx prettier --write .",
        "mailpit:up": "docker-compose -f docker-compose-mailpit.yml up -d",
        "mailpit:down": "docker-compose -f docker-compose-mailpit.yml down",
        "docker:build": "docker build --tag videocall/p2p:latest .",
        "docker:run": "docker run -d -p 3000:3000 --name videocall videocall/p2p:latest",
        "docker:start": "docker start videocall",
        "docker:stop": "docker stop videocall"
    },
    "keywords": [
        "webrtc",
        "socket.io",
        "p2p",
        "nodejs",
        "video",
        "audio",
        "client",
        "server",
        "streaming"
    ],
    "author": "Private Project",
    "license": "AGPL-3.0",
    "dependencies": {
        "@mattermost/client": "11.6.0",
        "@ngrok/ngrok": "1.7.0",
        "@sentry/node": "^10.51.0",
        "axios": "^1.16.0",
        "chokidar": "^5.0.0",
        "colors": "^1.4.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "crypto-js": "^4.2.0",
        "dompurify": "^3.4.2",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-openid-connect": "^2.20.2",
        "express-rate-limit": "^8.5.1",
        "he": "^1.2.0",
        "helmet": "^8.1.0",
        "httpolyglot": "0.1.2",
        "js-yaml": "^4.1.1",
        "jsdom": "^29.1.1",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^8.0.7",
        "openai": "^6.36.0",
        "qs": "^6.15.1",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "uuid": "14.0.0"
    },
    "devDependencies": {
        "mocha": "^11.3.0",
        "node-fetch": "^3.3.2",
        "nodemon": "^3.1.14",
        "prettier": "3.8.3",
        "proxyquire": "^2.1.3",
        "should": "^13.2.3",
        "sinon": "^22.0.0"
    }
}
